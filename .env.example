# ============================================================================
# Arca · Mercado Secundario IFC sobre Avalanche
# Plantilla de variables de entorno.
#
# Copia este archivo a .env y rellena los valores. NUNCA commitees .env real.
# Para Vercel: configura todas estas variables en el dashboard del proyecto
# (Settings → Environment Variables). Marca las que llevan prefijo
# NEXT_PUBLIC_* como disponibles para Production + Preview + Development.
# ============================================================================

# --- Database (Supabase hosted recomendado en producción) ---
DATABASE_URL="postgresql://hack:hack@localhost:5432/hackathon_avalanche"

# --- Redis (Upstash hosted recomendado en producción, TLS) ---
REDIS_URL="redis://localhost:6379"

# --- Blockchain ---
AVALANCHE_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
CHAIN_ID=43113
DEPLOYER_PRIVATE_KEY="0x..."
KYC_ISSUER_PRIVATE_KEY="0x..."

# --- Contract addresses (Fuji deploy actual) ---
# Si redeployas, actualiza estos valores + FUJI_FALLBACK en
# apps/web/src/lib/client/contracts.ts (el fallback evita que el bundle del
# cliente quede sin direcciones si Vercel/Turbopack pierde la inyección de
# NEXT_PUBLIC_* en compile time).
NEXT_PUBLIC_IDENTITY_REGISTRY="0x8Ca947A8c9714548eCe376a879D6755048018A82"
NEXT_PUBLIC_COMPLIANCE_REGISTRY="0x8Db4A89761b208Da299dB9f1979252093A56C45A"
NEXT_PUBLIC_TOKEN_FACTORY="0x500B3F119E09fA4503f7fE8D5724Ca7776257956"
NEXT_PUBLIC_SETTLEMENT="0x491BCC419E8Dd90d1783c234151c5B57A0Dc2A2A"
NEXT_PUBLIC_USDC="0x31E5aA694baebF0420170bD9b132F9b5c4b38A83"
NEXT_PUBLIC_DIVIDEND_DISTRIBUTOR="0x71dA4E2cbc181F7eE9936c7A8243566fDcAb93c6"
NEXT_PUBLIC_GOVERNANCE="0xfd2619c9d7b36c32309e613065bc0fd4f71e5f6d"

# --- Frontend ---
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Frontend toggle: false = prefer real APIs, true = always use in-memory mocks.
NEXT_PUBLIC_USE_MOCKS=false

# --- Supabase client (opcional, si usas Supabase JS directo en cliente) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- KYC provider (mock | sumsub) ---
KYC_PROVIDER="mock"
KYC_API_KEY=""
KYC_WEBHOOK_SECRET="replace-with-shared-secret"

# --- Sumsub (set KYC_PROVIDER=sumsub to enable) ---
# Get tokens from https://cockpit.sumsub.com → Dev space → App tokens
SUMSUB_BASE_URL="https://api.sumsub.com"
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
SUMSUB_LEVEL_NAME="basic-kyc-level"
SUMSUB_WEBHOOK_SECRET=""

# --- IPFS (Pinata) ---
PINATA_JWT=""

# --- App auth ---
# Mínimo 32 caracteres. Rotar tras cada deploy si la clave anterior pudo filtrarse.
JWT_SECRET="change-me-in-prod-min-32-chars-long-please-1234"

# --- Chain mode for SDK: mock | avalanche ---
CHAIN_MODE="mock"

# --- Logging level: trace|debug|info|warn|error ---
LOG_LEVEL="info"

# --- Indexer (apps/indexer) ---
# El indexer NO se deploya en Vercel (es un worker Node persistente).
# Para Vercel deploy estas vars no aplican; sí en Railway/Fly.io/Render.
INDEXER_PORT=3001
# mock  : consume Redis Streams from the mock chain (legacy)
# fuji  : watch Avalanche Fuji directly via viem (recommended)
# both  : run both consumers in parallel (transitional)
INDEXER_MODE="fuji"
# Backfill start block — first run scans from here forward. After that,
# ProcessedEvent dedupe + live watchContractEvent keep things in sync.
# 55000000 ≈ early Apr 2026 on Fuji; bump if you redeploy to a later block.
INDEXER_FUJI_FROM_BLOCK=55000000
INDEXER_FUJI_POLL_MS=4000
INDEXER_FUJI_CHUNK=2000

# --- Snowtrace / Routescan contract verification ---
# Routescan testnet acepta el placeholder "verifyContract" sin signup.
# Para mainnet, obtener API key real en https://routescan.io
ROUTESCAN_API_KEY="verifyContract"
