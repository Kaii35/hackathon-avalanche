# --- Database ---
DATABASE_URL="postgresql://hack:hack@localhost:5432/hackathon_avalanche"
REDIS_URL="redis://localhost:6379"

# --- Blockchain ---
AVALANCHE_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
CHAIN_ID=43113
DEPLOYER_PRIVATE_KEY="0x..."
KYC_ISSUER_PRIVATE_KEY="0x..."

# --- Contract addresses (filled after deploy) ---
NEXT_PUBLIC_IDENTITY_REGISTRY=""
NEXT_PUBLIC_COMPLIANCE_REGISTRY=""
NEXT_PUBLIC_TOKEN_FACTORY=""
NEXT_PUBLIC_SETTLEMENT=""
NEXT_PUBLIC_USDC=""

# --- Frontend ---
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# --- KYC provider (mock for hackathon) ---
KYC_PROVIDER="mock"
KYC_API_KEY=""
KYC_WEBHOOK_SECRET="replace-with-shared-secret"

# --- IPFS ---
PINATA_JWT=""

# --- App auth ---
JWT_SECRET="change-me-in-prod-min-32-chars-long-please-1234"

# --- Chain mode for SDK: mock | avalanche ---
CHAIN_MODE="mock"

# --- Logging level: trace|debug|info|warn|error ---
LOG_LEVEL="info"

# --- Indexer healthcheck port ---
INDEXER_PORT=3001

# --- Snowtrace / Routescan contract verification ---
# Routescan testnet acepta el placeholder "verifyContract" sin signup
# requerido. Para mainnet, obtener API key real en https://routescan.io
ROUTESCAN_API_KEY="verifyContract"
