{
  "name": "hackathon-avalanche",
  "version": "0.0.1",
  "private": true,
  "description": "Mercado secundario regulado para participaciones IFC sobre Avalanche",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "compile": "turbo run compile",
    "type-check": "turbo run type-check",
    "typecheck": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sol}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "marked": "^18.0.3",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "keccak",
      "secp256k1",
      "sharp",
      "bufferutil",
      "utf-8-validate",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
